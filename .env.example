# Salin ke .env lalu isi. Semua variabel opsional kecuali yang ditandai WAJIB.

APP_ENV=development
# Dipisah koma. Isi domain web HR dan aplikasi di produksi.
CORS_ORIGINS=*
PASSPORT_PUBLIC_BASE_URL=https://levelin.id/p

# --- Database ---
# Lokal cepat: SQLite. Produksi: connection string Supabase (Project Settings > Database).
DATABASE_URL=sqlite+aiosqlite:///./levelin.db
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# true bila memakai pooler mode transaksi (port 6543)
DB_PGBOUNCER=false

# --- Auth Supabase (WAJIB salah satu) ---
# Proyek dengan JWT secret (HS256): Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=
# Proyek dengan signing key asimetris (RS256/ES256): cukup isi URL, kunci diambil dari JWKS
SUPABASE_URL=
# Untuk undangan email, hapus akun Auth, dan Storage. Rahasia, hanya di server.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM ---
# Tanpa key semua fitur AI tetap jalan lewat cadangan berbasis aturan (engine=fallback).
# gemini | groq | anthropic
LLM_PROVIDER=gemini

# Gemini: buat key gratis di https://aistudio.google.com
# Cek kuota tiap model di AI Studio. Free tier hanya untuk demo; jangan kirim data pengguna asli.
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-3.8-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite

# Groq: ada paket gratis, key dari https://console.groq.com/keys
# Untuk memakai Qwen: GROQ_MODEL_MAIN=qwen/qwen3.8-27b (model preview, bisa dihentikan sewaktu-waktu)
GROQ_API_KEY=
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_LIGHT=llama-3.1-8b-instant

# Claude: berbayar, key dari https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL_MAIN=claude-opus-5-5
LLM_MODEL_LIGHT=claude-haiku-5-5
LLM_SERVER_FALLBACK=true

# --- Embedding ---
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
# Ubah hanya sebelum migrasi pertama (dimensi kolom pgvector)
EMBEDDING_DIM=1024

# --- Rate limit AI per pengguna ---
RATE_LIMIT_AUDIT_PER_DAY=10
RATE_LIMIT_EXPLAIN_PER_HOUR=20
RATE_LIMIT_NARRATIVE_PER_HOUR=20
RATE_LIMIT_CHAT_PER_HOUR=60
RATE_LIMIT_GRADE_PER_DAY=20

# --- Aturan produk ---
K_ANONYMITY_MIN=5
REVIEW_SAMPLE_RATE=0.10
FREE_MISSION_QUOTA=3
ORG_MEMBER_MISSION_QUOTA=20
REMINDER_DAYS=90

# --- Pembayaran (Midtrans Snap) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
PLAN_PLUS_PRICE=49000
PLAN_JALUR_PRICE=149000

# --- Penyimpanan dokumen misi kustom ---
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
SUPABASE_STORAGE_BUCKET=custom-missions
MAX_UPLOAD_MB=10

# --- Push notification (FCM HTTP v1) ---
# Path ke JSON service account Firebase
FCM_SERVICE_ACCOUNT_FILE=
